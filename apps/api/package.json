{
  "name": "@emr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "provision": "tsx src/database/provision.ts",
    "provision-operator": "tsx src/database/provision-operator.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prebuild": "pnpm --filter @emr/contracts --filter @emr/db build"
  },
  "dependencies": {
    "@emr/contracts": "workspace:*",
    "@emr/db": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.2.0",
    "jose": "^6.0.11",
    "otpauth": "^9.4.0",
    "pg": "^8.13.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}