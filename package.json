{
  "name": "emr",
  "private": true,
  "version": "0.1.0",
  "description": "Clinic EMR for small outpatient practices in India",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @emr/web --filter @emr/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @emr/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @emr/web dev",
    "dev:api": "pnpm --filter @emr/api dev",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @emr/db generate",
    "db:migrate": "pnpm --filter @emr/api migrate",
    "db:seed": "pnpm --filter @emr/api seed"
  },
  "devDependencies": {
    "argon2": "^0.44.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
