# Copy to .env before `docker compose up`.
#
#   cp .env.example .env
#   # then replace every CHANGE_ME below
#
# .env is gitignored. Nothing in this file is a working secret, on purpose: a
# committed default is a secret everyone who has ever cloned the repository
# knows, and the API refuses to start in production if it finds one.

# ---- Secrets ---------------------------------------------------------------
# Generate each of these separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Signs access tokens. Rotating it signs everyone out, which is the point.
JWT_SECRET=CHANGE_ME

# The database role the API connects as: NOBYPASSRLS, no DDL rights. The
# migration sets this password after creating the role.
APP_DB_PASSWORD=CHANGE_ME

# The messaging worker. Holds no privilege on encounter_internal_note.
WORKER_DB_PASSWORD=CHANGE_ME

# Read-only, for analytics and support.
READONLY_DB_PASSWORD=CHANGE_ME

# The migration/owner role. Runs DDL; the application never holds it.
POSTGRES_PASSWORD=CHANGE_ME

# ---- Deployment ------------------------------------------------------------
POSTGRES_USER=emr_migrator
POSTGRES_DB=emr

# Where the browser reaches this deployment. Share links are built from it, so
# getting it wrong produces links that resolve to nowhere.
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Days a new clinician may work before two-factor becomes mandatory.
MFA_GRACE_DAYS=7

# Seeds the acceptance fixtures. Set false for a real clinic.
SEED_DEMO_DATA=true

# ---- Host ports ------------------------------------------------------------
# Deliberately not 5432/6379, so this stack cannot collide with a Postgres or
# Redis already running on the machine.
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=4000
WEB_PORT=3000
