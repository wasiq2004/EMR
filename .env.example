# Copy to .env before `docker compose up`.
#
#   cp .env.example .env
#   # then replace every CHANGE_ME below
#
# .env is gitignored. Nothing in this file is a working secret, on purpose: a
# committed default is a secret everyone who has ever cloned the repository
# knows, and the API refuses to start in production if it finds one.

# ---- Secrets ---------------------------------------------------------------
# Generate each of these separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Encrypts each clinic's WhatsApp access token. SEPARATE from JWT_SECRET on
# purpose: rotating the signing secret signs everyone out, which is routine, and
# must not also make every stored token unreadable.
ENCRYPTION_KEY=CHANGE_ME

# Signs access tokens. Rotating it signs everyone out, which is the point.
JWT_SECRET=CHANGE_ME

# The database role the API connects as: NOBYPASSRLS, no DDL rights. The
# migration sets this password after creating the role.
APP_DB_PASSWORD=CHANGE_ME

# The messaging worker. Holds no privilege on encounter_internal_note.
WORKER_DB_PASSWORD=CHANGE_ME

# The operations console. BYPASSRLS, but with privileges on only five platform
# tables and `clinic` — it cannot read a patient because it has no grant to.
PLATFORM_DB_PASSWORD=CHANGE_ME

# Read-only, for analytics and support.
READONLY_DB_PASSWORD=CHANGE_ME

# The migration/owner role. Runs DDL; the application never holds it.
POSTGRES_PASSWORD=CHANGE_ME

# ---- The first operations-console account ----------------------------------
#
# Creates the Super Admin for the operations console (/platform) on deploy, so a
# host with no terminal attached — Dokploy, Coolify, CI — comes up with a
# console somebody can sign into. Nothing else creates one: there is no
# self-service sign-up and no default account.
#
# CREATE-ONLY. Once the account exists this is ignored, and the password here is
# NOT applied to it — a redeploy must not silently undo a rotation done in the
# console. To rotate, change it in the console.
#
# Leave BOTH blank to create nothing, and provision by hand instead:
#   docker compose run --rm migrate node dist/database/provision-operator.js \
#     --email ops@example.in --name "Your Name" --role PLATFORM_ADMIN
#
# THERE IS NO DEFAULT PASSWORD HERE ON PURPOSE. This account can suspend every
# clinic on the platform, so a value committed to the repository would be a
# known way in for anyone who has ever cloned it. The deploy REFUSES to start
# with a placeholder, one under 12 characters, or one with fewer than 6 distinct
# characters. Generate one:
#
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
#
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
# SUPPORT reads the estate, OPERATOR can suspend a clinic and change its plan,
# PLATFORM_ADMIN can also manage operators and plans. A fresh install needs
# PLATFORM_ADMIN, because the plan catalogue starts empty and only that role can
# create one.
PLATFORM_ADMIN_ROLE=PLATFORM_ADMIN

# ---- Deployment ------------------------------------------------------------
POSTGRES_USER=emr_migrator
POSTGRES_DB=emr

# Where the browser reaches this deployment. Share links are built from it, so
# getting it wrong produces links that resolve to nowhere.
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Days a new clinician may work before two-factor becomes mandatory.
MFA_GRACE_DAYS=7


# ---- Host ports ------------------------------------------------------------
# Deliberately not 5432/6379, so this stack cannot collide with a Postgres or
# Redis already running on the machine.
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=4000
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Reminder scheduler
# ---------------------------------------------------------------------------
# Authenticates POST /jobs/run-due, which a cron line calls to send follow-up
# reminders that have come due. A cron job has no user session, so a bearer
# secret is the right shape for it — and this is the only endpoint it opens.
# That endpoint takes no parameters, names no clinic or patient, and returns
# five integers; the work it triggers runs per clinic under ordinary RLS. A
# leaked value lets somebody make reminders go out early. It does not let them
# read anything.
#
# LEAVING IT EMPTY DISABLES THE ENDPOINT. It does not leave it open. A
# deployment with no reminder scheduler is a legitimate configuration.
#
#   openssl rand -hex 24
JOBS_SECRET=
